# ─── local perf/bench scratch ───────────────────────────────────────────
# Bench corpora and run logs are machine-local state, not reviewable. They
# also drown real hits in the picker when left inside the worktree.
.fff-bench/
.fff-bench/cache/
.fff-bench/runs/
.fff-bench/history/
.fff-bench/*.patch
.fff-bench/*.csv
.fff-bench/*.json
.fff-bench/*.py
.fff-bench/profile-driver/Cargo.lock
.fff-bench/profile-driver/probes-bak/
scratch/archive/bench-binaries/
scratch/archive/charts/
scratch/archive/dot-fff-bench-runs/
scratch/archive/*.json
scratch/archive/*.log
scratch/archive/*.out
scratch/archive/_*.py
scratch/archive/_*.ps1

# One-off probes / throwaway harnesses (kept under scratch/archive/keepers-scratch-*)
_head_*.rs
_ff_*.rs
_macro_test*
_pad_brute*
_tf_test*
_sz_probe.rs
*.pid

# Review/measurement evidence and moved scratch (machine-local)
scratch/archive/keepers-review-*/
scratch/archive/keepers-scratch-*/

# arena research lab artifacts
scratch/archive/arena_lab/*.exe
scratch/archive/arena_lab/*.bin

# ─── perf-branch scratch (observed, ignore-only) ──────────────────────────
# Tracked scratch stays tracked; purge separately with `git rm --cached`.
/*.log
/*.err
/*.txt
/*.ps1
!install-mcp.ps1
/*.jsonl
/chart.png
/fff-bench.json
.fff-bench/*.rs
.fff-bench/*.ps1
scratch/archive/*.jsonl
scratch/archive/*.png
scratch/archive/*.html
scratch/archive/*.svg
scratch/archive/*.csv
scratch/archive/*.md
scratch/archive/*.py
scratch/archive/*.ps1
